# Copy to .env and fill in the services you use. See README.md for how to get each key.

# --- Spotify (https://developer.spotify.com/dashboard) ---
# Optional for reading public playlists by link; needed to sign in and to write to Spotify.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must be registered on the Spotify app exactly as written here.
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8765/auth/spotify/callback

# --- YouTube Music (optional: OAuth; browser-header login needs nothing here) ---
# Google Cloud OAuth client of type "TVs and Limited Input devices", YouTube Data API v3 enabled.
YTMUSIC_CLIENT_ID=
YTMUSIC_CLIENT_SECRET=

# --- Apple Music (https://developer.apple.com/account/resources/authkeys/list, MusicKit key) ---
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=~/.music-sync/AuthKey_XXXXXXXXXX.p8
# Or skip the three above and paste a ready-made developer token:
# APPLE_DEVELOPER_TOKEN=
# Two-letter country code of your Apple Music account; detected automatically if empty.
# APPLE_STOREFRONT=us

# --- General ---
# Where tokens and sync state are kept.
# MUSIC_SYNC_HOME=~/.music-sync
# MUSIC_SYNC_HOST=127.0.0.1
# MUSIC_SYNC_PORT=8765
# 0..1: how similar a search result must be to count as the same song.
# MUSIC_SYNC_MATCH_THRESHOLD=0.72
